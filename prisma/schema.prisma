generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  role          String?
  banned        Boolean?     @default(false)
  banReason     String?
  banExpires    DateTime?
  accounts      Account[]
  invitations   Invitation[]
  members       Member[]
  sessions      Session[]
  expenses      Expense[]    @relation("ExpenseStaffUser")

  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  activeOrganizationId String?
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model Organization {
  id          String       @id
  name        String
  slug        String?      @unique
  logo        String?
  metadata    String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  invitations Invitation[]
  members     Member[]

  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  userId         String
  role           String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  inviterId      String
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("invitation")
}

model Category {
  id           String     @id @default(cuid())
  restaurantId String
  name         String
  sortOrder    Int        @default(0)
  menuItems    MenuItem[]

  @@index([restaurantId])
}

model MenuItem {
  id           String         @id @default(cuid())
  restaurantId String
  categoryId   String
  name         String
  description  String?
  price        Float
  isVeg        Boolean        @default(false)
  isAvailable  Boolean        @default(true)
  /// JSON array of { name: string, priceModifier: number }
  variants     Json?
  /// JSON array of { inventoryItemId: string, quantityRequired: number }
  recipe       Json?
  category     Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  dailySpecials DailySpecial[]

  @@index([restaurantId])
  @@index([categoryId])
}

model Table {
  id           String        @id @default(cuid())
  restaurantId String
  tableNumber  String
  capacity     Int
  status       TableStatus   @default(FREE)
  orders       Order[]
  reservations Reservation[]

  @@index([restaurantId])
}

model Reservation {
  id              String            @id @default(cuid())
  restaurantId    String
  customerName    String
  customerPhone   String
  partySize       Int
  reservationTime DateTime
  tableId         String?
  status          ReservationStatus @default(PENDING)
  /// Better Auth user id of the staff member who logged this reservation
  takenByUserId   String
  notes           String?
  createdAt       DateTime          @default(now())
  table           Table?            @relation(fields: [tableId], references: [id])

  @@index([restaurantId])
  @@index([restaurantId, reservationTime])
}

model Order {
  id                String        @id @default(cuid())
  restaurantId      String
  tableId           String?
  /// Better Auth user id — orders are entered by staff, not customers
  createdByUserId   String
  orderType         OrderType
  status            OrderStatus   @default(PENDING)
  /// JSON array of { menuItemId, name, quantity, unitPrice, variant?, notes? }
  items             Json
  subtotal          Float
  tax               Float
  packagingCharge   Float         @default(0)
  serviceCharge     Float         @default(0)
  splittingCharge   Float         @default(0)
  total             Float
  customerName      String?
  customerPhone     String?
  paymentStatus     PaymentStatus @default(PENDING)
  stockDeducted     Boolean       @default(false)
  razorpayOrderId   String?
  razorpayPaymentId String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  delivery          Delivery?
  table             Table?        @relation(fields: [tableId], references: [id])

  @@index([restaurantId])
  @@index([restaurantId, status])
  @@index([tableId])
}

model RestaurantSettings {
  id                     String   @id @default(cuid())
  restaurantId           String   @unique
  defaultPackagingCharge Float    @default(0)
  defaultServiceCharge   Float    @default(0)
  defaultSplittingCharge Float    @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([restaurantId])
}

model Delivery {
  id           String         @id @default(cuid())
  restaurantId String
  orderId      String         @unique
  /// Better Auth user id of the staff member acting as rider
  riderUserId  String
  status       DeliveryStatus @default(ASSIGNED)
  etaMinutes   Int?
  createdAt    DateTime       @default(now())
  deliveredAt  DateTime?
  order        Order          @relation(fields: [orderId], references: [id])

  @@index([restaurantId])
  @@index([restaurantId, status])
}

enum TableStatus {
  FREE
  OCCUPIED
  RESERVED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  CANCELLED
  NO_SHOW
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  SERVED
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DeliveryStatus {
  ASSIGNED
  IN_TRANSIT
  NEARBY
  DELIVERED
}

enum MovementType {
  OPENING_STOCK
  PURCHASE
  USAGE
  ADJUSTMENT
  WASTAGE
}

enum ExpenseType {
  GENERAL
  INVENTORY
}

enum ExpenseStatus {
  PAID
  PENDING
  CANCELLED
}

model Supplier {
  id             String          @id @default(cuid())
  restaurantId   String
  name           String
  contactName    String?
  email          String?
  phone          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  inventoryItems InventoryItem[]
  expenses       Expense[]

  @@index([restaurantId])
}

model InventoryItem {
  id              String          @id @default(cuid())
  restaurantId    String
  name            String
  category        String
  quantity        Float           @default(0)
  unit            String          @default("unit")
  unitCost        Float           @default(0)
  minReorderLevel Float           @default(10)
  supplierId      String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  supplier        Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  stockMovements  StockMovement[]
  expenses        Expense[]

  @@index([restaurantId])
  @@index([restaurantId, category])
}

model StockMovement {
  id              String        @id @default(cuid())
  restaurantId    String
  inventoryItemId String
  quantityChange  Float
  type            MovementType
  reason          String?
  createdById     String?
  createdAt       DateTime      @default(now())
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([inventoryItemId])
}

model Expense {
  id              String        @id @default(cuid())
  restaurantId    String
  type            ExpenseType   @default(GENERAL)
  name            String
  description     String?
  staffUserId     String?
  productName     String?
  weight          Float?
  unit            String?
  amount          Float
  date            DateTime      @default(now())
  status          ExpenseStatus @default(PAID)
  supplierId      String?
  supplierName    String?
  inventoryItemId String?
  createdById     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  supplier        Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  staffUser       User?         @relation("ExpenseStaffUser", fields: [staffUserId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([restaurantId, date])
  @@index([restaurantId, status])
  @@index([restaurantId, type])
}

model DailySpecial {
  id                 String    @id @default(cuid())
  restaurantId       String
  menuItemId         String?
  name               String
  category           String
  regularPrice       Float
  todayPrice         Float
  discount           String?
  availableQty       String    @default("Available")
  chefRecommendation String    @default("Must Try ⭐")
  description        String
  isAvailable        Boolean   @default(true)
  date               DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  menuItem           MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([restaurantId, date])
}

model StaffSalary {
  id            String    @id @default(cuid())
  restaurantId  String
  userId        String
  monthlySalary Float     @default(0)
  advancePaid   Float     @default(0)
  lastPaidDate  DateTime?
  paymentStatus String    @default("Pending")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([restaurantId, userId])
  @@index([restaurantId])
}



